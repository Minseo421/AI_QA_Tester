+      "specifier",
+      "return import(specifier)",
+    ) as (specifier: string) => Promise<any>;
+    return await dynamicImport("playwright");
+  } catch {
+    throw new Error(
+      "Playwright is not installed. Run `npm install` and then `npx playwright install chromium`.",
+    );
+  }
+}
