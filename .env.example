OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Browser-agent controls
AI_QA_BROWSER_HEADLESS=true
AI_QA_BROWSER_MAX_STEPS=3
AI_QA_BROWSER_SLOWMO_MS=0
AI_QA_BROWSER_ALLOW_WRITES=false

# Local demo only. Keep false for normal/public use.
AI_QA_ALLOW_PRIVATE_TARGETS=false

# Optional: use an existing Chrome/Chromium binary instead of Playwright's bundled browser.
# AI_QA_BROWSER_EXECUTABLE_PATH=/path/to/chromium
