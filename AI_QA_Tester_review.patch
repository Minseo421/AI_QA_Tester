+export function calculateQualityScore(findings: Finding[]) {
+  const severityPenalty = { critical: 30, high: 18, medium: 8, low: 3 } as const;
+  const penalty = findings.reduce((total, finding) => {
+    const kindMultiplier = finding.kind === "bug" ? 1 : 0.6;
+    return total + severityPenalty[finding.severity] * kindMultiplier * finding.confidence;
+  }, 0);
+  return Math.max(0, Math.min(100, Math.round(100 - penalty)));
+}
